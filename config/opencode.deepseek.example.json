{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseekrpc/deepseek-v4.1-flash-1017-exl3",
  "provider": {
    "deepseekrpc": {
      "name": "DeepSeekRPC",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://host.docker.internal:8081/v1",
        "apiKey": "{env:DEEPSEEKRPC_API_KEY}",
        "timeout": false,
        "headerTimeout": 300000,
        "chunkTimeout": 300000
      },
      "models": {
        "deepseek-v4.1-flash-1017-exl3": {
          "name": "DeepSeek V4.1 Flash 1017 EXL3",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "interleaved": {"field": "reasoning_content"},
          "modalities": {"input": ["text", "image"], "output": ["text"]},
          "limit": {"context": 1048576, "output": 8192},
          "options": {"thinking": {"type": "enabled"}, "speculative": false}
        }
      }
    }
  }
}
