 # cmake --build . --target _C
 # cmake --install . --component _C
 project(vllm_extensions LANGUAGES CXX)
+
+# EXL3 weights, BF16 KV/index rows and native BF16 vision do not call the
+# SM12x FP8/NVFP4 GEMMs. Their CUTLASS launch stubs pass 128-aligned structs
+# by value, which MSVC rejects (C2719). Keep the CUDA descriptor ABI intact.
+option(VLLM_DEEPSEEKRPC_EXL3 "Build the Windows DeepSeekRPC EXL3 profile" OFF)
+if(VLLM_DEEPSEEKRPC_EXL3 AND NOT WIN32)
+  message(FATAL_ERROR "The DeepSeekRPC EXL3 build profile requires Windows")
+endif()
 
 set(CMAKE_CXX_STANDARD 20)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
